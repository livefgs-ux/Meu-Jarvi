# Example environment variables for Meu Jarvis.
#
# Notes:
# - The project does not auto-load .env files by default. Use this as a reference.
# - Do NOT put real secrets in version control.
# - Gemini API key is expected in config/api_keys.json (local-only, gitignored).

# --- Read-only Memory Context (OFF by default) ---
# Enable only if you explicitly want read-only memory context injected into the runtime prompt.
JARVIS_READONLY_MEMORY=0

# Required when JARVIS_READONLY_MEMORY=1
JARVIS_MEMORY_PROJECT=Meu-Jarvi

# Optional limits
JARVIS_MEMORY_MAX_CHARS=2500
JARVIS_MEMORY_LIMIT=8
JARVIS_MEMORY_DB=data/jarvis_memory.db

